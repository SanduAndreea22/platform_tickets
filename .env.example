# Copy this file to .env and fill in real values. Never commit the real .env.

SECRET_KEY=dev-secret-local-only
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Leave unset to use SQLite locally. Set to a postgres:// URL in production.
DATABASE_URL=

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=ron

# reCAPTCHA (leave unset in dev — Google test keys are used automatically)
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# Email (leave unset in dev — console backend is used automatically)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@ticketplatform.local

# Optional: auto-creates this superuser on first deploy (see users/management/commands/ensure_superuser.py)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
